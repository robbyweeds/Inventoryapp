# Copy to .env for local use; production systemd reads /etc/equiptags.env.
NODE_ENV=production
PORT=5002
EQUIPTAGS_COMPANY_NAME=Your Company
# Replace BOTH placeholders with distinct four-digit PINs before first start.
EQUIPTAGS_EDIT_PIN=REPLACE_WITH_FOUR_DIGITS
EQUIPTAGS_MASTER_PIN=REPLACE_WITH_DIFFERENT_FOUR_DIGITS
